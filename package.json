{
  "name": "claude-office",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=electron/preload.js",
    "electron:dev": "npm --no-update-notifier run build:preload && electron .",
    "electron:build": "npm --no-update-notifier run build:preload && npm --no-update-notifier run build && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public && electron-builder",
    "fix:native": "find node_modules/node-pty/prebuilds -name spawn-helper -exec chmod +x {} \\; ; [ -f node_modules/node-pty/build/Release/spawn-helper ] && chmod +x node_modules/node-pty/build/Release/spawn-helper || true",
    "rebuild:native": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.2",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "node-pty": "^1.0.0",
    "postcss": "^8.5.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "^4.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5"
  },
  "overrides": {
    "node-gyp": "^11.0.0"
  }
}
